rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() && request.auth.token.email in [
        'tmashiko@kiryo.ac.jp'
      ];
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isTeacher());
      allow write: if isSignedIn() && (request.auth.uid == userId || isTeacher());
    }

    match /student_progress/{studentId} {
      allow read: if isSignedIn() && (request.auth.uid == studentId || isTeacher());
      allow write: if isSignedIn() && (request.auth.uid == studentId || isTeacher());
    }

    match /shared_variants/{variantId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }
  }
}
