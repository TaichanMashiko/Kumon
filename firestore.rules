rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/kumon_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/kumon_users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /kumon_users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isTeacher());
      allow write: if isSignedIn() && (request.auth.uid == userId || isTeacher());
    }

    match /kumon_student_progress/{studentId} {
      allow read: if isSignedIn() && (request.auth.uid == studentId || isTeacher());
      allow write: if isSignedIn() && (request.auth.uid == studentId || isTeacher());
    }

    match /kumon_shared_variants/{variantId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    match /kumon_remediation_analytics/{outcomeId} {
      allow read: if isTeacher();
      allow create, update: if isSignedIn();
    }
  }
}
